# --- Steel (self-hosted) ---
STEEL_BASE_URL=http://localhost:3000
STEEL_API_KEY=

# --- Model ---
# MODEL_PROVIDER: google | openai   (extend _build_model() in agent.py for more)
MODEL_PROVIDER=google
MODEL_ID=gemini-2.0-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Agent behavior ---
# Session storage file (relative to agent/ working dir)
AGENT_DB_FILE=tmp/agent.db
# Max tool calls per run, to stop stuck browsing loops from hanging a session
TOOL_CALL_LIMIT=25